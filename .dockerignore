# Keep the build context small and, more importantly, keep secrets and local
# state out of the image. Anything matched here is invisible to the build.

# Secrets — no env file may be baked into an image. Real values are supplied
# at runtime: by docker-compose.yml (env_file) locally, or by the platform's
# environment variables when deployed.
**/.env
**/.env.*
!**/.env.example

# Version control and editor state
.git
.gitignore
.vscode
.idea
*.swp

# Python
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.venv/
**/venv/
**/*.egg-info/

# Node — dependencies are reinstalled from the lockfile inside the image, and
# a host node_modules would be the wrong platform anyway.
**/node_modules/
**/dist/
**/.vite/
**/npm-debug.log*

# Local runtime artifacts
backend/uploads/*
!backend/uploads/.gitkeep
*.log
*.sqlite3

# Not needed at runtime
docker-compose.yml
render.yaml
akash-aiportfolio.png
