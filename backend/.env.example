# Copy to .env and fill in. Never commit .env.
#
# NOTE: these names must match what app/config.py reads. An earlier version of
# this file used DATABASE_HOST/DATABASE_USER/... which the code ignores, so the
# app silently fell back to its built-in defaults.

# ── Database ──────────────────────────────────────────────
# Option A: a full connection URL. Render, Neon and Supabase give you this.
# If set, it wins and the DB_* parts below are ignored.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option B: individual parts (local docker-compose setup).
DB_HOST=127.0.0.1
DB_PORT=5436
DB_NAME=auronix_db
DB_USER=auronix_admin
DB_PASSWORD=change-me

# "disable" for local docker, "require" for managed Postgres.
# Defaults to require when ENVIRONMENT=production.
DB_SSLMODE=disable

# ── Application ───────────────────────────────────────────
ENVIRONMENT=development

# Must be False in production: when True the API returns raw exception text,
# which for database errors includes the failing SQL and its parameters.
DEBUG=True

# Signs admin JWTs. Must be >= 32 chars in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# ── Admin panel credentials ───────────────────────────────
ADMIN_EMAIL=admin@example.com

# bcrypt hash of the admin password — NOT the password itself.
# Generate with:
#   python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your-password'))"
ADMIN_PASSWORD_HASH=

# ── CORS ──────────────────────────────────────────────────
# Comma-separated. Must list your deployed frontend origin in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Uploads ───────────────────────────────────────────────
UPLOAD_FOLDER=./uploads
