# Environment for the Docker Compose stack.
#
#   cp .env.docker.example .env.docker    # then fill in the secrets
#   docker compose up -d --build
#
# Deliberately NOT named ".env": Compose auto-loads that filename and expands
# "$" inside it, which would mangle a bcrypt hash ($2b$12$...) into an empty
# string. This file is attached with `env_file:` instead, so every value is
# passed to the containers exactly as written — no escaping needed.
#
# Not to be confused with backend/.env, which is only read when running the
# API directly on the host with uvicorn. This file configures the containers.

# ── Database ──────────────────────────────────────────────
# How the app reaches the database: "postgres" is the compose service name on
# the private network, and 5432 is the container's own port (not the host
# mapping). sslmode=disable is correct for a connection that never leaves the
# bridge network; use require for any database hosted elsewhere.
#
# The postgres container gets its credentials from docker-compose.yml, which
# defaults to auronix_admin / Auronix2602 / auronix_db. To change them, set
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB in a plain `.env` file
# (Compose reads that one for the compose file itself) AND update the URL
# below to match. Note that Postgres writes the credentials into its data
# directory on first start — changing them later does not update an existing
# volume, so you would have to ALTER the role or recreate the volume.
DATABASE_URL=postgresql://auronix_admin:Auronix2602@postgres:5432/auronix_db?sslmode=disable

# ── Application ───────────────────────────────────────────
# production enables the startup guard: the app refuses to boot with a
# development SECRET_KEY, DEBUG on, a missing admin hash, or wildcard CORS.
ENVIRONMENT=production

# Must be false in production. When true the API returns raw exception text,
# which for database errors includes the failing SQL and its parameters.
DEBUG=false

# Signs admin JWTs. At least 32 characters in production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# The frontend is served from the same origin as the API, so CORS is not
# exercised in normal use. Set this to your public URL if you split them.
ALLOWED_ORIGINS=http://localhost:8000

# ── Admin panel ───────────────────────────────────────────
ADMIN_EMAIL=admin@example.com

# bcrypt hash of the admin password — NOT the password itself.
#
# IMPORTANT: every "$" must be DOUBLED. Compose expands "$" in env files, so
# an unescaped hash arrives at the app truncated to "$2b$12" and every login
# silently fails. The app checks the format at startup and refuses to boot
# with a clear message if you forget, but it is easier to just escape it.
#
# This command prints the value already escaped, ready to paste:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode().replace('$','$$'))"
#
# Correct:   ADMIN_PASSWORD_HASH=$$2b$$12$$abcdef...
# Wrong:     ADMIN_PASSWORD_HASH=$2b$12$abcdef...
ADMIN_PASSWORD_HASH=
